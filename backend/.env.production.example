# Copy to .env on the server ONLY. Never commit the real file. Run `php artisan key:generate` once.
APP_NAME="Small Business Command Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sbcc
DB_USERNAME=sbcc_app
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=warning
# Set to the proxy IPs (comma list) or * when behind a TLS-terminating load balancer.
TRUSTED_PROXIES=
SBCC_PRIMARY_OWNER_EMAIL=
